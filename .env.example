# Server configuration only. Never copy private credentials into the Mac bundle.
# Start locally from frontend/: node --env-file=../.env.local registry.mjs
HUMA_STORAGE_BACKEND=local
HUMA_REGISTRY_HOST=127.0.0.1
HUMA_REGISTRY_PORT=4318

# Storage backend: local (a folder), r2 (below) or arkiv (https://docs.arkiv.network; see frontend/ARKIV.md).
# arkiv keeps pages, proofs, records, documents, links and sessions on Arkiv, encrypted; the daily upload counters stay local.
# Every write is a paid testnet transaction, so the account needs funds (hub.arkiv.network/faucet).
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
# 64 hex digits, kept secret and backed up: without it nothing stored on Arkiv can be read again.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARKIV_ENCRYPTION_KEY=
ARKIV_EXPIRY_DAYS=180  # 1 to 182: the longest lifetime Arkiv allows

# Set backend=r2 after configuring a private bucket and a bucket-scoped token.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Durable UTC-day publication budgets. Master + public proof bytes are reserved
# together before content upload. Retrying one prepared publication is idempotent.
HUMA_DAILY_PUBLICATION_LIMIT=1000
HUMA_DAILY_UPLOAD_BYTES=1073741824
HUMA_UPLOADER_DAILY_PUBLICATION_LIMIT=100
HUMA_UPLOADER_DAILY_UPLOAD_BYTES=134217728

# Coinbase embedded-wallet uploader sign-in. Project ID is public; API keys stay server-side.
NEXT_PUBLIC_CDP_PROJECT_ID=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true

# World ID (IDKit): lets a writer show one real, unique person stands behind a shared page. Off unless all three are set.
# App ID and RP ID come from the World Developer Portal; the action must exist there with unlimited verifications.
# The signing key is a secret: it signs each request on the server and never reaches the browser.
HUMA_WORLD_APP_ID=
HUMA_WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
HUMA_WORLD_ACTION=verify-publisher
# With World ID on, sharing a page written in a browser needs it (the human check). false makes it an optional badge.
HUMA_WORLD_REQUIRED=true
# production, or staging to try the World ID simulator (staging proofs are refused in production).
HUMA_WORLD_ENVIRONMENT=production

# The page /example opens: a shared page link, full (/original/<id>#<token>) or short (/p/<code>#<key>), with or without
# the site it was copied from. Keep the quotes: without them the # starts a comment and the key is lost.
HUMA_EXAMPLE_LINK=""
